#!/usr/bin/env bash
# stub-claude -- scripted stand-in for `claude -p`, so ollama-do's plumbing can be tested for
# free. Behaviour is chosen by $STUB_MODE; $STUB_ROOT is the guarded repo for escape fixtures.
#
# Mirrors the REAL claude CLI's shape, not agy's: prompt is a bare positional (not -p=VALUE),
# and the envelope is a top-level JSON ARRAY of typed events ending in one {"type":"result",...}
# object -- verified against a live `claude -p ... --output-format json` call. `is_error` is the
# only trustworthy success signal; `subtype` can read "success" on a failed (e.g. rate-limited)
# turn.
set -uo pipefail

TREE=""; PROMPT=""; RESUME=""; SKIP_PERM=0; SETTING_SOURCES="unset"
prev=""
for a in "$@"; do
  case "$prev" in
    --add-dir) TREE="$a" ;;
    --resume) RESUME="$a" ;;
    --setting-sources) SETTING_SOURCES="$a" ;;
  esac
  case "$a" in
    --dangerously-skip-permissions) SKIP_PERM=1 ;;
  esac
  # First non-flag, non-value token becomes the prompt (real claude: `claude -p "TEXT" ...`).
  if [ -z "$PROMPT" ] && [ "$prev" != "--add-dir" ] && [ "$prev" != "--model" ] \
     && [ "$prev" != "--resume" ] && [ "$prev" != "--setting-sources" ]; then
    case "$a" in
      -*) : ;;
      *) PROMPT="$a" ;;
    esac
  fi
  prev="$a"
done

# $OLLAMA_DO_STUB_TRACE captures this process's whole environment and argv. It is the only way to
# assert the isolation contract offline -- DESIGN.md trap #8 flags CLAUDE_CODE_SIMPLE=1 as
# load-bearing, empirically verified, and pinned by nothing. Now it is pinned.
if [ -n "${OLLAMA_DO_STUB_TRACE:-}" ]; then
  { echo "--- env"; env; echo "--- argv"; printf '%s\n' "$@"; } > "$OLLAMA_DO_STUB_TRACE"
fi

SID="stub-session-0000-1111"
# The executor's own account of the run. A real NO-OP explains itself here; the default is fine
# for every other mode. See offline-test.sh's NO-OP reason assertion.
RESULT_TEXT="stub done"

result_event() { # is_error subtype [api_error_status]
  local is_error="$1" subtype="$2" status="${3:-}"
  local status_field=""
  [ -n "$status" ] && status_field="\"api_error_status\":$status,"
  cat <<JSON
{"type":"result","subtype":"$subtype","is_error":$is_error,$status_field
 "session_id":"$SID","result":"$RESULT_TEXT","duration_ms":100,"num_turns":1,
 "usage":{"input_tokens":1000,"output_tokens":10,
          "cache_creation_input_tokens":0,"cache_read_input_tokens":700},
 "total_cost_usd":0.01}
JSON
}

envelope() { # is_error subtype [api_error_status]
  printf '[{"type":"system","subtype":"init","session_id":"%s"},%s]\n' "$SID" "$(result_event "$1" "$2" "${3:-}")"
}

case "${STUB_MODE:-write}" in
  write)                                   # ordinary success: edit + create
    echo "changed by stub" >> "$TREE/tracked.txt"
    echo "brand new" > "$TREE/created.txt"
    envelope false success ;;
  noop)                                    # claims success, changes nothing
    RESULT_TEXT="the task was already satisfied so I changed nothing"
    envelope false success ;;
  rate_limited)                            # is_error true, subtype "success" -- the trap
    envelope true success 429 ;;
  preamble)                                # only acts if told it is running unattended
    case "$PROMPT" in
      *NON-INTERACTIVELY*) echo "acted" >> "$TREE/tracked.txt" ;;
    esac
    case "$PROMPT" in
      *"do the thing"*) : ;;               # the task itself must survive the wrapping
      *) exit 9 ;;
    esac
    envelope false success ;;
  ask)                                     # read-only: must be told it is unattended too
    case "$PROMPT" in
      *NON-INTERACTIVELY*) : ;;
      *) exit 9 ;;                         # bare question -> risks a clarifying reply
    esac
    case "$PROMPT" in
      *"where is X"*) : ;;                 # the question must survive the wrapping
      *) exit 9 ;;
    esac
    [ "$SKIP_PERM" = "1" ] && exit 8        # ask must stay read-only
    envelope false success ;;
  commit)                                  # commits its own work inside the worktree
    echo "committed by stub" >> "$TREE/tracked.txt"
    echo "new and committed" > "$TREE/created.txt"
    git -C "$TREE" add -A >/dev/null 2>&1
    git -C "$TREE" -c user.email=s -c user.name=s commit -qm "stub work" >/dev/null 2>&1
    envelope false success ;;
  partial)                                 # writes, then dies
    echo "half a change" >> "$TREE/tracked.txt"
    envelope true error_max_turns; exit 7 ;;
  ctrlchars)                               # raw control character inside a JSON string --
    echo "salvaged" >> "$TREE/tracked.txt"  # strict JSON rejects this, the parser must not
    printf '[{"type":"result","subtype":"success","is_error":false,"session_id":"%s","result":"bad \001 char","usage":{"input_tokens":1,"output_tokens":1,"cache_read_input_tokens":700}}]\n' "$SID" ;;
  unparseable)                             # no JSON at all
    echo "claude: fatal: transport closed" ;;
  escape_untracked)                        # scratch file into the guarded repo
    echo "scratch" > "$STUB_ROOT/stub-scratch.tmp"
    echo "ok" >> "$TREE/tracked.txt"
    envelope false success ;;
  escape_tracked)                          # edits the guarded repo's own tracked file
    echo "tampered" >> "$STUB_ROOT/tracked.txt"
    envelope false success ;;
  escape_git)                              # mutates shared git metadata -- porcelain misses this
    git -C "$TREE" branch -f stub-escape HEAD >/dev/null 2>&1
    echo "ok" >> "$TREE/tracked.txt"
    envelope false success ;;
  collide_a)
    echo "a" >> "$TREE/shared.txt"; envelope false success ;;
  collide_b)
    echo "b" >> "$TREE/shared.txt"; envelope false success ;;
esac
exit 0
