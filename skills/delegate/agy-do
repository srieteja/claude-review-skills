#!/usr/bin/env bash
# agy-do -- hand a task to antigravity in an isolated worktree, get a reviewable patch back.
#
# The point is token economy: the executor's read-edit-test loop happens in its own process
# against its own worktree, and the only thing that comes back to the caller is a patch and a
# stat. Nothing is applied automatically -- the review gate is the design.
#
#   agy-do --task plan.md --root .                 # one slice
#   agy-do --tasks slices/ --root . --jobs 3       # fan-out, one worktree each
#   agy-do --ask "where is X?" --tree <dir> --root .
#   agy-do --conversation <id> --tree <dir> --task delta.md --root .
#
# Writes <work>/<id>.{patch,stat,files,raw.json,err,conv,base} and a verdict per task.
#
# exit 0  every task settled, repo untouched
# exit 3  same, but the executor wrote into --root; the files are in <work>/escaped
# exit 1  refused: the executor modified tracked files or git metadata in --root
#
# Targets bash 3.2 (macOS system bash): no mapfile, no `wait -n`, no assoc arrays.
set -euo pipefail

HERE="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$HERE/../../lib/common.sh"
load_config

MODEL="${AGY_DO_MODEL:-claude-opus-4-6-thinking}"
# refute's 20m is tuned for refuting one claim; an implementation that builds and tests
# will exceed it, and a timeout mid-write yields a PARTIAL patch rather than a clean failure.
TIMEOUT="${AGY_DO_TIMEOUT:-45m}"
JOBS="${AGY_DO_JOBS:-3}"
LEDGER="${AGY_DO_LEDGER:-$HOME/.local/state/agy-do/ledger}"
AGY="${AGY_DO_BIN:-agy}"

TASK=""; TASKS=""; ASK=""; ROOT=""; BASE="HEAD"; TREE=""; CONV=""; WORK=""
DIRTY=0; KEEP=0

die()  { printf '\033[31magy-do: %s\033[0m\n' "$*" >&2; exit 1; }
say()  { printf '\033[36m==>\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[33m!!\033[0m %s\n' "$*" >&2; }

usage() {
  cat >&2 <<USAGE
usage: agy-do (--task <file> | --tasks <dir> | --ask <question>) --root <repo> [options]

  --task <file>       a single task/plan file to implement
  --tasks <dir>       implement every *.md in <dir>, one worktree each, in parallel
  --ask <question>    read-only question against an existing --tree (no edits)
  --root <repo>       repo to guard: anything appearing here during the run escaped
  --tree <dir>        reuse an existing worktree (required for --ask and --conversation)
  --conversation <id> resume a prior executor session; send only the delta
  --base <ref>        worktree base (default $BASE)
  --dirty             carry uncommitted tracked edits from --root into the worktree
  --work <dir>        scratch + output dir (default: a fresh mktemp)
  --jobs <n>          tasks in flight at once (default $JOBS)
  --model <id>        agy model (default $MODEL)
  --timeout <dur>     agy --print-timeout (default $TIMEOUT)
  --keep              keep worktrees after the run (default: remove, work dir stays)
  -h, --help          this

env: AGY_DO_MODEL AGY_DO_TIMEOUT AGY_DO_JOBS AGY_DO_LEDGER AGY_DO_BIN
USAGE
  exit 1
}

while [ $# -gt 0 ]; do
  case "$1" in
    --task) TASK="$2"; shift ;;
    --tasks) TASKS="$2"; shift ;;
    --ask) ASK="$2"; shift ;;
    --root) ROOT="$2"; shift ;;
    --tree) TREE="$2"; shift ;;
    --conversation) CONV="$2"; shift ;;
    --base) BASE="$2"; shift ;;
    --dirty) DIRTY=1 ;;
    --work) WORK="$2"; shift ;;
    --jobs) JOBS="$2"; shift ;;
    --model) MODEL="$2"; shift ;;
    --timeout) TIMEOUT="$2"; shift ;;
    --keep) KEEP=1 ;;
    -h|--help) usage ;;
    *) die "unknown option: $1" ;;
  esac
  shift
done

[ -n "$ROOT" ] || usage
[ -n "$TASK$TASKS$ASK" ] || usage
# --ask without --tree cuts its own worktree. Reusing a warm one is cheaper on the far side --
# measured 79% cache read -- but the saving that matters is on ours: the answer enters context
# and the codebase does not, which holds at zero cache hit. Requiring a warm tree would make
# asking impossible in a fresh session, which is exactly when grepping blind costs the most.
[ -n "$CONV" ] && [ -z "$TREE" ] && die "--conversation needs --tree (the worktree to resume in)"

for bin in git python3 "$AGY"; do
  command -v "$bin" >/dev/null 2>&1 || die "$bin not found on PATH"
done

ROOT="$(git -C "$ROOT" rev-parse --show-toplevel 2>/dev/null)" \
  || die "--root is not a git repository"

# Default the work dir OUTSIDE $ROOT: worktrees and scratch living inside the guarded repo
# would register as escapes against themselves.
WORK="${WORK:-$(mktemp -d "${TMPDIR:-/tmp}/agy-do.XXXXXX")}"
mkdir -p "$WORK" "$(dirname "$LEDGER")"

# ---------------------------------------------------------------------------
# The guard.
#
# `git status --porcelain` is what refute uses, and it is not sufficient once the executor
# writes. $TREE/.git is a pointer into $ROOT/.git/worktrees/<id>, so the object store, HEAD,
# refs and the stash are all reachable from inside the worktree and porcelain sees none of it:
# a `git commit`, `git stash` or `git branch -f` run in there mutates $ROOT invisibly.
#
# This guard is the entire reason --dangerously-skip-permissions below is acceptable. If the
# worktree isolation is ever removed, that flag must go with it.
#
# Same shape as ollama-do's snapshot_root()/guard_repo() (ollama-agents/ollama-do) -- kept
# structurally identical across both drivers so the policy can't drift silently between them.
# ---------------------------------------------------------------------------
snapshot_root() {
  local r="$1"
  git -C "$r" status --porcelain | LC_ALL=C sort
  echo "--- HEAD"
  git -C "$r" rev-parse HEAD
  echo "--- refs"
  git -C "$r" for-each-ref --format='%(refname) %(objectname)' | LC_ALL=C sort
  echo "--- stash"
  git -C "$r" stash list
}

guard_repo() { # pre-snapshot-file post-snapshot-file -> return 0 clean / 3 quarantined / 1 refused
  local pre="$1" post="$2"
  diff -q "$pre" "$post" >/dev/null 2>&1 && return 0
  local escaped
  escaped="$(diff "$pre" "$post" | grep '^>' | sed 's/^> //' || true)"
  # Only a bare untracked-file porcelain line ("?? path") is recoverable by moving the file.
  # Anything else -- a tracked-file diff line, a HEAD/refs/stash change (including a stash left
  # behind: it's repo state, not a loose file, nothing to safely auto-move) -- refuses in place.
  if printf '%s\n' "$escaped" | grep -qvE '^\?\? '; then
    warn "the executor changed tracked files or git metadata in $ROOT, left in place:
$(printf '%s\n' "$escaped" | sed 's/^/      /')"
    return 1
  fi
  mkdir -p "$WORK/escaped"
  printf '%s\n' "$escaped" | sed 's/^?? //' | while read -r p; do
    [ -n "$p" ] && [ -e "$ROOT/$p" ] || continue
    mkdir -p "$WORK/escaped/$(dirname "$p")"
    mv "$ROOT/$p" "$WORK/escaped/$p"
  done
  warn "the executor wrote into $ROOT, quarantined in $WORK/escaped"
  return 3
}

# agy has emitted stdout that jq refuses ("Invalid string: control characters ... must be
# escaped") -- a raw control character inside a JSON string. python3's strict=False accepts
# exactly that, and salvaging from the first parseable '{' survives leading narration.
parse_envelope() {
  python3 - "$1" <<'PY'
import json, sys
raw = open(sys.argv[1], encoding='utf-8', errors='replace').read()

def load(s):
    try:
        v = json.loads(s, strict=False)
        return v if isinstance(v, dict) else None
    except Exception:
        return None

d = load(raw)
i = raw.find('{')
while d is None and i != -1:
    d = load(raw[i:])
    i = raw.find('{', i + 1)
if d is None:
    sys.exit(1)

u = d.get('usage') or {}
out = d.get('structured_output')
resp = out if isinstance(out, str) else (json.dumps(out) if out else d.get('response', ''))
fields = [d.get('status', ''), d.get('conversation_id', ''),
          u.get('input_tokens', 0), u.get('output_tokens', 0),
          u.get('cache_read_tokens', 0), u.get('total_tokens', 0)]
print('\t'.join(str(x) for x in fields))
print(resp or '')
PY
}

ledger_line() { # id verdict status in out cache secs files
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(basename "$ROOT")" "$1" "$MODEL" \
    "$2" "$3" "$4" "$5" "$6" "$7" "$8" >> "$LEDGER" \
    || warn "ledger write failed ($LEDGER) -- continuing, verdict still printed below"
}

# ---------------------------------------------------------------------------
# One task: worktree, invoke, extract, verdict.
# ---------------------------------------------------------------------------
run_agy() { # id prompt-file tree [readonly]
  id="$1"; pf="$2"; tr="$3"; ro="${4:-0}"
  # --add-dir is what pins the tree, and it must be absolute: agy does not inherit cwd -- it
  # runs in ~/.gemini/antigravity-cli/scratch and resolves relative paths against its own
  # persisted project root. Without it every read and write lands in the live repo, and the
  # result reads exactly like a correct one. See pr-review/FINDING-agy-ignores-tree.md.
  set -- --sandbox --add-dir "$tr" --model "$MODEL" \
         --output-format json --print-timeout "$TIMEOUT"
  [ -n "$CONV" ] && set -- "$@" --conversation "$CONV"
  # A read-only intent is not a read-only capability, but withholding the edit mode and the
  # permission bypass keeps --ask from running builds or writing files unattended.
  [ "$ro" = "0" ] && set -- "$@" --mode accept-edits --dangerously-skip-permissions
  agy_env "$AGY" "$@" -p="$(cat "$pf")" > "$WORK/$id.raw.json" 2> "$WORK/$id.err"
}

do_task() { # id task-file
  id="$1"; tf="$2"
  start=$(date +%s)

  if [ -n "$TREE" ]; then
    tr="$TREE"
  else
    tr="$WORK/tree/$id"
    mkdir -p "$WORK/tree"
    git -C "$ROOT" worktree add --detach "$tr" "$BASE" >/dev/null 2>&1 \
      || { echo "FAILED" > "$WORK/$id.verdict"; warn "$id: could not create worktree"; return 0; }
    if [ "$DIRTY" = "1" ]; then
      # Commit the carried edits immediately: without this the output patch would contain the
      # user's own work, and applying it back to a $ROOT that still holds it double-applies.
      if ! git -C "$ROOT" diff HEAD --quiet 2>/dev/null; then
        git -C "$ROOT" diff HEAD | git -C "$tr" apply - 2>/dev/null
      fi
      # `git diff HEAD` only ever covers tracked files -- untracked new files (e.g. a doc that was
      # never `git add`ed) are invisible to it and would silently vanish from the worktree.
      git -C "$ROOT" ls-files --others --exclude-standard | while IFS= read -r f; do
        mkdir -p "$tr/$(dirname "$f")" && cp -P "$ROOT/$f" "$tr/$f"
      done || true
      git -C "$tr" -c user.email=agy-do -c user.name=agy-do \
        commit -aqm "carried dirty state" 2>/dev/null || true
    fi
  fi
  tr="$(cd "$tr" && pwd -P)"
  git -C "$tr" rev-parse HEAD > "$WORK/$id.base"

  # Wrap the task in a preamble that says it is unattended. Without one the model answers
  # conversationally -- observed twice: it produced a correct plan, ended with "let me know if
  # you approve", and print mode returned that as SUCCESS with an empty diff. Asking carries the
  # same hazard with a worse tell: a clarifying question also comes back SUCCESS, and the answer
  # is prose either way, so no downstream check can tell it from a real answer. Callers cannot
  # be relied on to remember this, so the harness owns it for both modes.
  if [ -n "$ASK" ]; then tpl="$HERE/ask.prompt"; else tpl="$HERE/implement.prompt"; fi
  pf="$WORK/$id.prompt"
  # The redirect truncates $pf before sed opens $tf, so a caller pointing --task at that exact
  # path would silently send the preamble wrapped around nothing. Sending an empty task is
  # indistinguishable downstream from a task the executor declined, so refuse instead.
  [ "$tf" = "$pf" ] && die "task file collides with the wrapped prompt path: $pf"
  sed -e "/__TASK__/r $tf" -e "/__TASK__/d" "$tpl" > "$pf"

  rc=0
  run_agy "$id" "$pf" "$tr" "${ASK:+1}" || rc=$?

  status=""; conv=""; tin=0; tout=0; tcache=0
  if parse_envelope "$WORK/$id.raw.json" > "$WORK/$id.parsed" 2>/dev/null; then
    IFS=$'\t' read -r status conv tin tout tcache _ < "$WORK/$id.parsed"
    [ -n "$conv" ] && printf '%s' "$conv" > "$WORK/$id.conv"
    tail -n +2 "$WORK/$id.parsed" > "$WORK/$id.answer"
  else
    # A parse failure is a failure, never a silent pass -- and a dropped conversation_id
    # silently costs the correction round its cheap path, so say so.
    warn "$id: could not parse the executor's output; see $WORK/$id.raw.json"
    status="UNPARSEABLE"
  fi

  base="$(cat "$WORK/$id.base")"
  if [ -z "$ASK" ]; then
    # add -A first, because plain `git diff` omits new files and implementations create them.
    # Diff against the recorded base SHA rather than --cached, because an executor that commits
    # inside its worktree leaves nothing staged and --cached would call a finished change NO-OP.
    git -C "$tr" add -A >/dev/null 2>&1 || true
    git -C "$tr" diff "$base" > "$WORK/$id.patch" 2>/dev/null || : > "$WORK/$id.patch"
    git -C "$tr" diff --stat "$base" > "$WORK/$id.stat" 2>/dev/null || : > "$WORK/$id.stat"
    git -C "$tr" diff --name-only "$base" > "$WORK/$id.files" 2>/dev/null || : > "$WORK/$id.files"
  else
    : > "$WORK/$id.patch"; : > "$WORK/$id.stat"; : > "$WORK/$id.files"
  fi

  if [ -n "$ASK" ]; then
    verdict=$([ "$status" = "SUCCESS" ] && echo "OK" || echo "FAILED")
  elif [ -s "$WORK/$id.patch" ]; then
    # A half-implemented patch that still applies cleanly is the most dangerous thing this
    # produces. It must never be bucketed with FAILED, where it would be ignored.
    verdict=$([ "$rc" = "0" ] && [ "$status" = "SUCCESS" ] && echo "OK" || echo "PARTIAL")
  else
    # Claimed done, changed nothing. The implementation-side analogue of refute's ERROR:
    # a loud failure, never a pass.
    verdict=$([ "$rc" = "0" ] && [ "$status" = "SUCCESS" ] && echo "NO-OP" || echo "FAILED")
  fi

  echo "$verdict" > "$WORK/$id.verdict"
  nfiles=$(wc -l < "$WORK/$id.files" | tr -d ' ')
  ledger_line "$id" "$verdict" "$status" "$tin" "$tout" "$tcache" "$(( $(date +%s) - start ))" "$nfiles"
  printf '    %-24s %-8s %s files\n' "$id" "$verdict" "$nfiles" >&2
}

# ---------------------------------------------------------------------------
# Dispatch.
# ---------------------------------------------------------------------------
IDS=""
if [ -n "$ASK" ]; then
  printf '%s\n' "$ASK" > "$WORK/ask.question"
  IDS="ask"; TASKFILE_ask="$WORK/ask.question"
elif [ -n "$TASK" ]; then
  [ -s "$TASK" ] || die "no task at $TASK"
  IDS="task"; TASKFILE_task="$TASK"
else
  [ -d "$TASKS" ] || die "--tasks is not a directory: $TASKS"
  for f in "$TASKS"/*.md; do
    [ -e "$f" ] || die "no *.md task files in $TASKS"
    n="$(basename "$f" .md)"
    IDS="$IDS $n"
    eval "TASKFILE_${n//[^a-zA-Z0-9_]/_}=\"\$f\""
  done
fi

# Baseline AFTER any worktree creation would have registered, but worktrees are created inside
# do_task -- so take it now and let `git worktree add`'s own metadata be filtered by the
# worktree-prune below. Refs and HEAD are unaffected by --detach worktree creation.
snapshot_root "$ROOT" > "$WORK/repo.pre"

say "$MODEL: ${IDS// /, } (work: $WORK)"
for id in $IDS; do
  var="TASKFILE_${id//[^a-zA-Z0-9_]/_}"
  eval "tf=\$$var"
  if [ "$(echo "$IDS" | wc -w | tr -d ' ')" = "1" ]; then
    do_task "$id" "$tf"
  else
    do_task "$id" "$tf" &
    while [ "$(jobs -pr | wc -l | tr -d ' ')" -ge "$JOBS" ]; do sleep 1; done
  fi
done
wait

# Remove worktrees before the post-run comparison so their registration is not read as an
# escape. --keep leaves them for inspection; prune still clears the metadata.
if [ -z "$TREE" ]; then
  for id in $IDS; do
    [ "$KEEP" = "1" ] || git -C "$ROOT" worktree remove --force "$WORK/tree/$id" 2>/dev/null || true
  done
  git -C "$ROOT" worktree prune 2>/dev/null || true
fi

# ---------------------------------------------------------------------------
# Report, then guard.
# ---------------------------------------------------------------------------
echo >&2
for id in $IDS; do
  v="$(cat "$WORK/$id.verdict" 2>/dev/null || echo FAILED)"
  case "$v" in
    OK)      [ -n "$ASK" ] && { say "answer:"; cat "$WORK/$id.answer"; } \
                           || say "$id OK -- review: $WORK/$id.patch" ;;
    PARTIAL) warn "$id PARTIAL -- the executor did not finish but wrote files. Read every hunk of $WORK/$id.patch before applying." ;;
    NO-OP)   warn "$id NO-OP -- the executor reported success and changed nothing. This is a failure, not a pass." ;;
    *)       warn "$id $v -- see $WORK/$id.err" ;;
  esac
done

# Fan-out collisions: two slices editing one file cannot both be applied blind.
if [ "$(echo "$IDS" | wc -w | tr -d ' ')" -gt 1 ]; then
  DUPES="$(cat "$WORK"/*.files 2>/dev/null | LC_ALL=C sort | uniq -d || true)"
  [ -n "$DUPES" ] && warn "slices touch the same files -- apply in sequence and re-check:
$(printf '%s\n' "$DUPES" | sed 's/^/      /')"
fi

snapshot_root "$ROOT" > "$WORK/repo.post"
guard_rc=0
guard_repo "$WORK/repo.pre" "$WORK/repo.post" || guard_rc=$?
exit "$guard_rc"
