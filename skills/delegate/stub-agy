#!/usr/bin/env bash
# stub-agy -- a scripted stand-in for `agy`, so the plumbing can be tested for free.
# Behaviour is chosen by $STUB_MODE; $STUB_ROOT is the guarded repo for the escape fixtures.
set -uo pipefail

TREE=""; PROMPT=""
prev=""
for a in "$@"; do
  [ "$prev" = "--add-dir" ] && TREE="$a"
  case "$a" in -p=*) PROMPT="${a#-p=}" ;; esac
  prev="$a"
done

envelope() { # status
  cat <<JSON
{"conversation_id":"stub-0000-1111","status":"$1","response":"stub done",
 "duration_seconds":0.1,"num_turns":1,
 "usage":{"input_tokens":1000,"output_tokens":10,"thinking_tokens":0,
          "cache_read_tokens":700,"total_tokens":1010}}
JSON
}

case "${STUB_MODE:-write}" in
  write)                                   # ordinary success: edit + create
    echo "changed by stub" >> "$TREE/tracked.txt"
    echo "brand new" > "$TREE/created.txt"
    envelope SUCCESS ;;
  noop)                                    # claims success, changes nothing
    envelope SUCCESS ;;
  preamble)                                # only acts if told it is running unattended
    case "$PROMPT" in
      *NON-INTERACTIVELY*) echo "acted" >> "$TREE/tracked.txt" ;;
    esac
    case "$PROMPT" in
      *"do the thing"*) : ;;               # the task itself must survive the wrapping
      *) exit 9 ;;
    esac
    envelope SUCCESS ;;
  ask)                                     # read-only: must be told it is unattended too
    case "$PROMPT" in
      *NON-INTERACTIVELY*) : ;;
      *) exit 9 ;;                         # bare question -> risks a clarifying reply
    esac
    case "$PROMPT" in
      *"where is X"*) : ;;                 # the question must survive the wrapping
      *) exit 9 ;;
    esac
    for a in "$@"; do
      case "$a" in --dangerously-skip-permissions|--mode) exit 8 ;;  # ask must stay read-only
      esac
    done
    envelope SUCCESS ;;
  commit)                                  # commits its own work inside the worktree
    echo "committed by stub" >> "$TREE/tracked.txt"
    echo "new and committed" > "$TREE/created.txt"
    git -C "$TREE" add -A >/dev/null 2>&1
    git -C "$TREE" -c user.email=s -c user.name=s commit -qm "stub work" >/dev/null 2>&1
    envelope SUCCESS ;;
  partial)                                 # writes, then dies
    echo "half a change" >> "$TREE/tracked.txt"
    envelope FAILURE; exit 7 ;;
  ctrlchars)                               # raw control character inside a JSON string --
    echo "salvaged" >> "$TREE/tracked.txt"  # strict JSON rejects this, the parser must not
    printf '{"conversation_id":"stub-0000-1111","status":"SUCCESS","response":"bad \001 char","usage":{"input_tokens":1,"output_tokens":1,"cache_read_tokens":700,"total_tokens":2}}\n' ;;
  unparseable)                             # no JSON at all
    echo "agy: fatal: transport closed" ;;
  escape_untracked)                        # scratch file into the guarded repo
    echo "scratch" > "$STUB_ROOT/stub-scratch.tmp"
    echo "ok" >> "$TREE/tracked.txt"
    envelope SUCCESS ;;
  escape_tracked)                          # edits the guarded repo's own tracked file
    echo "tampered" >> "$STUB_ROOT/tracked.txt"
    envelope SUCCESS ;;
  escape_git)                              # mutates shared git metadata -- porcelain misses this
    git -C "$TREE" branch -f stub-escape HEAD >/dev/null 2>&1
    echo "ok" >> "$TREE/tracked.txt"
    envelope SUCCESS ;;
  collide_a)
    echo "a" >> "$TREE/shared.txt"; envelope SUCCESS ;;
  collide_b)
    echo "b" >> "$TREE/shared.txt"; envelope SUCCESS ;;
esac
exit 0
