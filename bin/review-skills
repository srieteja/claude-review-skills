#!/usr/bin/env bash
# review-skills -- install the skills, and show what a review on this machine would run.
# Targets bash 3.2 (macOS system bash).
set -euo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  L="$(readlink "$SELF")"
  case "$L" in /*) SELF="$L" ;; *) SELF="$(dirname "$SELF")/$L" ;; esac
done
REPO="$(cd -P "$(dirname "$SELF")/.." && pwd)"
. "$REPO/lib/common.sh"

usage() {
  cat <<EOF
usage: review-skills <command>

  install          link every skill into \${CLAUDE_SKILLS_DIR:-~/.claude/skills} and create
                   $(config_file) from the template if there is none
  doctor           tools, GitHub login, config, backends and the models each preset resolves to
  models [regular|intense] [--refresh]
                   the finders and refuter a review would run; --refresh asks every backend afresh
  test [--list]    run every offline suite (no model is called, nothing is spent)
EOF
}

say()  { printf '%s\n' "$*"; }
good() { printf '  \033[32m✓\033[0m %s\n' "$*"; }
poor() { printf '  \033[31m✗\033[0m %s\n' "$*"; }
note() { printf '  \033[33m-\033[0m %s\n' "$*"; }

cmd_install() {
  local dest="${CLAUDE_SKILLS_DIR:-$HOME/.claude/skills}" cfg s name rc=0
  mkdir -p "$dest"
  for s in "$REPO"/skills/*/; do
    s="${s%/}"; name="${s##*/}"
    if [ -L "$dest/$name" ] && [ "$(readlink "$dest/$name")" = "$s" ]; then
      good "$name (already linked)"
    elif [ -e "$dest/$name" ] || [ -L "$dest/$name" ]; then
      poor "$dest/$name is in the way -- move it aside and install again"; rc=1
    else
      ln -s "$s" "$dest/$name"; good "$name -> $s"
    fi
  done
  cfg="$(config_file)"
  if [ -e "$cfg" ]; then
    good "config: $cfg (kept)"
  else
    mkdir -p "$(dirname "$cfg")"
    (umask 077; cp "$REPO/config.example.env" "$cfg")
    good "config: $cfg (from the template -- add your keys there)"
  fi
  return $rc
}

# show_models <preset>: one line of what that preset resolves to, or why nothing does.
show_models() {
  local flag=""
  if resolve_models "$1" 2>/dev/null; then
    [ "$SAME_FAMILY" = 0 ] || flag="  (same family as a finder: weaker refutation)"
    printf '  %-8s %s -> refuted by %s%s\n' "$1" "$RESOLVED_FINDERS" "$RESOLVED_REFUTER" "$flag"
  else
    printf '  %-8s no model is reachable\n' "$1"; return 1
  fi
}

cmd_models() {
  local presets="regular intense" a
  for a; do
    case "$a" in
      regular|intense) presets="$a" ;;
      --refresh) rm -f "$(models_cache)"/*.models ;;
      *) printf 'review-skills models: unknown argument: %s\n' "$a" >&2; return 2 ;;
    esac
  done
  load_config
  for a in $presets; do show_models "$a" || return 1; done
}

cmd_doctor() {
  local rc=0 t cfg k
  say "tools"
  for t in bash git gh jq curl python3 awk find; do
    if command -v "$t" >/dev/null 2>&1; then good "$t"; else poor "$t missing"; rc=1; fi
  done
  for t in timeout gtimeout; do command -v "$t" >/dev/null 2>&1 && { good "$t"; break; }; done \
    || note "no timeout/gtimeout: an anthropic or ollama refuter cannot run"
  if gh auth status >/dev/null 2>&1; then good "gh signed in"; else poor "gh not signed in (gh auth login)"; rc=1; fi

  say "config"
  cfg="$(config_file)"
  if [ ! -e "$cfg" ]; then note "$cfg: none (review-skills install creates it)"
  elif [ -n "$(find "$cfg" \( -perm -040 -o -perm -004 \) -print 2>/dev/null)" ]; then
    poor "$cfg is readable by others -- chmod 600 it"; return 1
  else good "$cfg"; fi
  load_config
  for k in OLLAMA_API_KEY ANTHROPIC_API_KEY; do
    if [ -n "${!k:-}" ]; then good "$k set"; else note "$k unset"; fi
  done
  [ "${ANTHROPIC_USE_API_KEY:-}" != 1 ] || note "ANTHROPIC_USE_API_KEY=1: claude bills the API key, not the login"

  say "backends"
  if anthropic_ready; then good "claude signed in"; else note "claude not signed in (claude auth login)"; fi
  if command -v agy >/dev/null 2>&1; then
    if agy_list >/dev/null 2>&1; then good "agy signed in"; else note "agy not signed in"; fi
  else note "agy not installed"; fi
  if [ -z "${OLLAMA_API_KEY:-}" ]; then note "ollama: no OLLAMA_API_KEY"
  elif ollama_list >/dev/null 2>&1; then good "ollama.com accepts the key"
  else note "ollama.com did not accept the key or serve a listed model"; fi

  say "models"
  show_models regular || rc=1
  show_models intense || rc=1
  return $rc
}

suites() { (cd "$REPO" && ls lib/*-test.sh skills/*/*-test.sh bin/*-test.sh 2>/dev/null); }

cmd_test() {
  local t out rc=0
  [ "${1:-}" != --list ] || { suites; return 0; }
  for t in $(suites); do
    if out="$(bash "$REPO/$t" 2>&1)"; then good "$t"
    else poor "$t"; printf '%s\n' "$out" | grep -E '✗|FAIL' | head -8; rc=1; fi
  done
  return $rc
}

case "${1:-}" in
  install) shift; cmd_install "$@" ;;
  doctor)  shift; cmd_doctor "$@" ;;
  models)  shift; cmd_models "$@" ;;
  test)    shift; cmd_test "$@" ;;
  ""|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
